# Copy to .env and replace the public hostname before deploying.
NORA_DEPLOY_MODE=public
PUBLIC_BASE_URL=https://themes.example.com
LISTEN_ADDR=0.0.0.0:8090
DATA_DIR=/data
DATABASE_PATH=/data/themes.db
MAX_THEME_MIB=32
THEME_ACCESS=anonymous
OFFLINE_POLICY=allow
ADMIN_ALLOWED_CIDRS=0.0.0.0/0,::/0
TRUSTED_PROXY_CIDRS=172.16.0.0/12
